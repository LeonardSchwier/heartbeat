# Environment file for heartbeat.py - credentials only, no domains/hosts.
#
# Usage:
#   1. cp examples/heartbeat.env.example /etc/heartbeat/heartbeat.env
#   2. chmod 600 /etc/heartbeat/heartbeat.env
#   3. Fill in real values below
#   4. Reference it from systemd (see heartbeat.service) or `source` it
#      before running from cron.
#
# This file is gitignored; never commit the real one.

HEARTBEAT_SMTP_HOST=smtp.mail-provider.example
HEARTBEAT_SMTP_PORT=587
HEARTBEAT_SMTP_USER=heartbeat@example.com
HEARTBEAT_SMTP_PASSWORD=change-me
HEARTBEAT_SMTP_FROM=heartbeat@example.com
HEARTBEAT_SMTP_TO=you@example.com,oncall@example.com

# Optional, only needed if borg_check.enabled is true in checks.yml
HEARTBEAT_BORG_PASSPHRASE=change-me

# Optional overrides (defaults shown)
# HEARTBEAT_CHECKS=/etc/heartbeat/checks.yml
# HEARTBEAT_CONF=/etc/heartbeat/heartbeat.conf
# HEARTBEAT_LOG=/var/log/heartbeat.log
